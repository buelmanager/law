# AI 법률 상담 챗봇 환경 변수 예시
# 사용법: 이 파일을 `.env`로 복사하고 값을 입력하세요
# 주의: .env 파일은 Git에 커밋하지 마세요!

# ========================================
# Slack 연동 설정
# ========================================
# Slack Bot User OAuth Token (xoxb-로 시작)
# 획득 방법: https://api.slack.com/apps → Your App → OAuth & Permissions
SLACK_BOT_TOKEN=xoxb-your-token-here

# Slack Signing Secret (요청 검증용)
# 획득 방법: https://api.slack.com/apps → Your App → Basic Information → App Credentials
SLACK_SIGNING_SECRET=your-signing-secret-here

# ========================================
# AI 모델 설정
# ========================================
# 임베딩 모델 이름 (HuggingFace 모델 ID)
EMBEDDINGS_MODEL_NAME=intfloat/multilingual-e5-large

# ChromaDB 저장 경로
CHROMADB_PATH=./vectordb

# LLM 모델 파일 경로 (GGUF 포맷)
LLM_MODEL_PATH=./models/qwen2.5-7b-instruct-q4_k_m.gguf

# ========================================
# 서버 설정
# ========================================
# 서버 포트 (HF Spaces는 7860 필수)
PORT=7860

# 서버 호스트
HOST=0.0.0.0

# 디버그 모드 (True/False)
DEBUG=False

# ========================================
# API 키 (필요한 경우)
# ========================================
# OpenAI API 키 (사용 시)
# OPENAI_API_KEY=sk-your-key-here

# HuggingFace API 토큰 (비공개 모델 사용 시)
# HUGGINGFACE_TOKEN=hf_your-token-here

# 법제처 Open API 인증키 (데이터 수집용)
# LAW_GO_KR_API_KEY=your-api-key-here
