# AI 법률 상담 챗봇 환경 변수 예시
# 사용법: 이 파일을 `.env`로 복사하고 값을 입력하세요
# 주의: .env 파일은 Git에 커밋하지 마세요!

# ========================================
# Slack 연동 설정
# ========================================
# Slack Bot User OAuth Token (xoxb-로 시작)
# 획득 방법: https://api.slack.com/apps → Your App → OAuth & Permissions
SLACK_BOT_TOKEN=xoxb-your-token-here

# Slack Signing Secret (요청 검증용)
# 획득 방법: https://api.slack.com/apps → Your App → Basic Information → App Credentials
SLACK_SIGNING_SECRET=your-signing-secret-here

# ========================================
# AI 모델 설정
# ========================================
# 임베딩 모델 이름 (HuggingFace 모델 ID)
EMBEDDINGS_MODEL_NAME=intfloat/multilingual-e5-large

# ChromaDB 저장 경로
CHROMADB_PATH=./vectordb

# LLM 모델 파일 경로 (GGUF 포맷)
LLM_MODEL_PATH=./models/qwen2.5-7b-instruct-q4_k_m.gguf

# ========================================
# 서버 설정
# ========================================
# 서버 포트 (HF Spaces는 7860 필수)
PORT=7860

# 서버 호스트
HOST=0.0.0.0

# 디버그 모드 (True/False)
DEBUG=False

# ========================================
# API 키 (필요한 경우)
# ========================================
# OpenAI API 키 (사용 시)
# OPENAI_API_KEY=sk-your-key-here

# HuggingFace API 토큰 (비공개 모델 사용 시)
# HUGGINGFACE_TOKEN=hf_your-token-here

# 법제처 Open API 인증키 (데이터 수집용)
# LAW_GO_KR_API_KEY=your-api-key-here

# ========================================
# Claude Code CLI 원격 실행 설정
# ========================================
# 허용된 Slack 사용자 ID (쉼표로 구분)
# 획득 방법: Slack에서 @user의 프로필 → "..." → "Copy member ID"
# 예: ALLOWED_SLACK_USERS=U12345ABC,U67890DEF
ALLOWED_SLACK_USERS=

# Claude CLI 작업 디렉토리
CLAUDE_WORK_DIR=/home/user/law

# ========================================
# 배포 URL 설정
# ========================================
# 허용된 CORS Origins (쉼표로 구분)
# 예: ALLOWED_ORIGINS=https://your-domain.com,https://another-domain.com
ALLOWED_ORIGINS=

# 챗봇 API 서버 URL (HuggingFace Spaces)
CHATBOT_URL=

# 랜딩 페이지 URL (Vercel)
LANDING_URL=

# ========================================
# 배포 토큰 (선택)
# ========================================
# GitHub Personal Access Token
# GITHUB_TOKEN=ghp_your-token-here

# Vercel 배포 토큰
# VERCEL_TOKEN=your-vercel-token-here

# GitHub Repository URL
# GITHUB_REPO_URL=https://github.com/your-username/your-repo.git

# HuggingFace Repository URL
# HF_REPO_URL=https://huggingface.co/spaces/your-username/your-space
